# Nunca commitar valores reais. Copie para server/.env
PORT=8787
DATABASE_URL="file:./dev.db"
APP_BASE_URL="http://localhost:5173"

# Tray — API oficial. Sem estas variáveis o adapter recusa conexão.
TRAY_API_URL=
TRAY_API_TOKEN=
TRAY_WEBHOOK_SECRET=

# SINK ERP — preencher só após documentação oficial no repositório.
SINK_API_URL=
SINK_API_TOKEN=
SINK_API_DOCS_AVAILABLE=false

# WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Segurança
WEBHOOK_TOLERANCE_SECONDS=300
